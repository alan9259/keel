DEFINE SCHEMA

    RECORD TYPE CD_ActivityLog (
        CD_activityID    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_amount        DOUBLE QUERYABLE SORTABLE,
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_date          TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ChatMessage (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_roleRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CheckIn (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_date          TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_energy        INT64 QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moodRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CheckInSymptom (
        CD_checkIn       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_severity      INT64 QUERYABLE SORTABLE,
        CD_sourceRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_symptom       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CycleEntry (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_date          TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DailySummary (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_day           TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generatedAt   TIMESTAMP QUERYABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_signalsJSON   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_HealthSample (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_day           TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeID        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_value         DOUBLE QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Insight (
        CD_accentRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_detail        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generatedAt   TIMESTAMP QUERYABLE SORTABLE,
        CD_iconKey       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeframe     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Medication (
        CD_autoLogDoses    INT64 QUERYABLE SORTABLE,
        CD_catalogGroupID  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_cycleAnchor     TIMESTAMP QUERYABLE SORTABLE,
        CD_cycleLength     INT64 QUERYABLE SORTABLE,
        CD_cyclePauseDays  INT64 QUERYABLE SORTABLE,
        CD_date            TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_dosage          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_doseAmount      DOUBLE QUERYABLE SORTABLE,
        CD_doseChangedAt   TIMESTAMP QUERYABLE SORTABLE,
        CD_doseTime        TIMESTAMP QUERYABLE SORTABLE,
        CD_doseTimesJSON   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_doseUnitRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_frequencyRaw    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isActive        INT64 QUERYABLE SORTABLE,
        CD_isCompounded    INT64 QUERYABLE SORTABLE,
        CD_isOffLabel      INT64 QUERYABLE SORTABLE,
        CD_isTracked       INT64 QUERYABLE SORTABLE,
        CD_kindRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_methodRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduleKindRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeOfDayRaw    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timing          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_weekdaysMask    INT64 QUERYABLE SORTABLE,
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MedicationLog (
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_date          TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_medication    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_slot          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_taken         INT64 QUERYABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Symptom (
        CD_categoryRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isArchived    INT64 QUERYABLE SORTABLE,
        CD_isCustom      INT64 QUERYABLE SORTABLE,
        CD_isDefaultChip INT64 QUERYABLE SORTABLE,
        CD_name          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt     TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        CD_appVersion          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_appleUserID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_deviceModel         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_email               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_firstName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_healthKitAuthorized INT64 QUERYABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_localeID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_osVersion           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_pathwayRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_region              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncStatusRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeZoneID          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_trackingStartDate   TIMESTAMP QUERYABLE SORTABLE,
        CD_updatedAt           TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE KeelBackupArchive (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        appVersion      STRING,
        archive         ASSET,
        exportedAt      TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
