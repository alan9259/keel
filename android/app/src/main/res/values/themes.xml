<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything inside is drawn by Compose from KeelTheme. -->
    <style name="Theme.Keel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/keel_launch_background</item>
    </style>

    <!-- Launch: the mark on a rosewood disc, as the launcher icon, until her saved
         state has loaded (so a returning user never glimpses onboarding). -->
    <style name="Theme.Keel.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/keel_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/keel_rosewood</item>
        <item name="postSplashScreenTheme">@style/Theme.Keel</item>
    </style>
</resources>
