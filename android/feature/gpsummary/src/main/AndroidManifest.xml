<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Hands the GP Visit Summary PDF to the app she picks in the share sheet, read-only
             and only for that share (the grant is on the intent). Nothing else is served. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.gpsummary"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gp_summary_paths" />
        </provider>
    </application>
</manifest>
